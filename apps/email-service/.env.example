# EduProctor Node.js Email Microservice Configuration

# Microservice Port
EMAIL_SERVICE_PORT=5050

# ---------------------------------------------------------------------------
# OPTION 1: External SMTP Delivery (Sends REAL emails to YOPmail / Gmail)
# ---------------------------------------------------------------------------
# To deliver directly to actual YOPmail (e.g. testcandidate@yopmail.com),
# configure an outbound SMTP provider below (Gmail App Password or Brevo):

# --- GMAIL SMTP SETUP (Recommended for testing): ---
# 1. Go to Google Account > Security > 2-Step Verification
# 2. At the bottom, click "App passwords"
# 3. Create a password for "EduProctor" (16 letters, e.g. "abcd efgh ijkl mnop")
# 4. Fill in:
EXTERNAL_SMTP_HOST=smtp.gmail.com
EXTERNAL_SMTP_PORT=587
EXTERNAL_SMTP_SECURE=false
EXTERNAL_SMTP_USER=your-email@gmail.com
EXTERNAL_SMTP_PASS=your-16-char-app-password
EXTERNAL_EMAIL_FROM="EduProctor Intelligence <your-email@gmail.com>"

# --- BREVO (Sendinblue) SETUP (Free 300 emails/day, no personal email needed): ---
# EXTERNAL_SMTP_HOST=smtp-relay.brevo.com
# EXTERNAL_SMTP_PORT=587
# EXTERNAL_SMTP_SECURE=false
# EXTERNAL_SMTP_USER=your-brevo-login-email
# EXTERNAL_SMTP_PASS=your-brevo-smtp-key
# EXTERNAL_EMAIL_FROM="EduProctor Intelligence <verified-sender@domain.com>"

# ---------------------------------------------------------------------------
# OPTION 2: Local Dev Mailbox (Captured locally on http://localhost:8025)
# ---------------------------------------------------------------------------
# When EXTERNAL_SMTP_HOST is left commented out or blank,
# EduProctor defaults to the embedded local SMTP server (127.0.0.1:1025).
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025

