DATABASE_URL=postgresql+psycopg://eduproctor:eduproctor@localhost:5432/eduproctor
REDIS_URL=redis://localhost:6379/0
CHROMA_URL=http://localhost:8001
WEB_BASE_URL=http://localhost:5173
ENVIRONMENT=dev
# random, at least 32 characters (required outside dev/test):  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# anthropic (default) or mock = rule-based stand-in for demos/tests (dev only)
AGENT_LLM=anthropic

# ---------------------------------------------------------------------------
# EMAIL CONFIGURATION (Local Mailpit vs Real External SMTP Delivery)
# ---------------------------------------------------------------------------
# Set MAIL_MODE to "local" for local Mailpit testing at http://localhost:8025
# Set MAIL_MODE to "smtp" for real external SMTP delivery
MAIL_MODE=local
EMAIL_MODE=local

# 1. Local Development Settings (defaults to Mailpit / embedded SMTP on port 1025)
LOCAL_SMTP_HOST=localhost
LOCAL_SMTP_PORT=1025

# 2. External Production / Live Test Settings (Requires valid SMTP relay credentials)
# Example Gmail SMTP:
# EXTERNAL_SMTP_HOST=smtp.gmail.com
# EXTERNAL_SMTP_PORT=587
# EXTERNAL_SMTP_SECURE=false
# EXTERNAL_SMTP_USER=your-email@gmail.com
# EXTERNAL_SMTP_PASS=your-16-char-app-password
# EXTERNAL_EMAIL_FROM="EduProctor Intelligence <your-email@gmail.com>"

# Example Brevo (Sendinblue) SMTP (300 free emails/day):
# EXTERNAL_SMTP_HOST=smtp-relay.brevo.com
# EXTERNAL_SMTP_PORT=587
# EXTERNAL_SMTP_SECURE=false
# EXTERNAL_SMTP_USER=your-brevo-login@domain.com
# EXTERNAL_SMTP_PASS=your-brevo-smtp-key
# EXTERNAL_EMAIL_FROM="EduProctor Intelligence <verified@domain.com>"

SMTP_HOST=localhost
SMTP_PORT=1025
# smtp (falls back to a file outbox when unreachable) / file / memory
MAIL_BACKEND=smtp
# Fernet key:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
EVIDENCE_ENCRYPTION_KEY=
STORAGE_DIR=storage
RETENTION_DAYS=90
# dev = pixel comparison, NOT face recognition (dev/test only); insightface for real use
IDENTITY_ENGINE=dev
IDENTITY_MATCH_THRESHOLD=0.45
IDENTITY_UNCERTAIN_THRESHOLD=0.30
# proctoring defaults
GLANCE_MIN_S=1.0
FLAG_THRESHOLD_S=3.0
MAX_FLAGS=3
YAW_LIMIT_DEG=30
PITCH_LIMIT_DEG=20
RETURN_TO_SCREEN_S=0.5
# evaluation rules
STRONG_TOPIC_PCT=80
WEAK_TOPIC_PCT=60
MIN_QUESTIONS_PER_TOPIC=3
MISCONCEPTION_MIN_COUNT=2
# background (run the evaluation agent after scoring) / off
EVALUATION_JOBS=background
