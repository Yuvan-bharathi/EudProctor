DATABASE_URL=postgresql+psycopg://eduproctor:eduproctor@localhost:5432/eduproctor
REDIS_URL=redis://localhost:6379/0
CHROMA_URL=http://localhost:8001
WEB_BASE_URL=http://localhost:5173
ENVIRONMENT=dev
# random, at least 32 characters (required outside dev/test):  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# anthropic (default) or mock = rule-based stand-in for demos/tests (dev only)
AGENT_LLM=anthropic
# --- Outgoing email (assessment invitations) ---
# localhost:1025 = Mailpit: captures mail at http://localhost:8025, it does NOT reach real inboxes.
# To deliver to candidates use a real relay, e.g. Gmail with an App Password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=true
#   SMTP_USERNAME=you@gmail.com  SMTP_PASSWORD=<16-char app password>  EMAIL_FROM_ADDRESS=you@gmail.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
EMAIL_FROM_ADDRESS=
# smtp / file / memory. A failed SMTP send is reported as "Failed" (copy kept in storage/outbox).
MAIL_BACKEND=smtp
# true = redirect ALL invitations to EMAIL_TEST_RECIPIENT instead of the candidate (dev only)
EMAIL_TEST_MODE=false
EMAIL_TEST_RECIPIENT=
# Fernet key:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
EVIDENCE_ENCRYPTION_KEY=
STORAGE_DIR=storage
RETENTION_DAYS=90

# --- Internship flow (all optional; defaults shown) ---
# Attendance: full day = 8 h of logged-in time, half day = 4 h (sessions are summed, breaks excluded)
# FULL_DAY_HOURS=8
# HALF_DAY_HOURS=4
# INTERNSHIP_TIMEZONE=Asia/Kolkata
# STALL_HOURS=4                 # in-progress task + punched in + no activity -> mentor alert
# MAX_MENTEES_PER_MENTOR=2
# WEEKLY_QUIZ_QUESTIONS=5
# MIN_QUESTIONS_PER_SKILL=3     # a skill level is shown only after this many questions
# LangGraph state for paused agents (waiting for mentor approval): sqlite (file under STORAGE_DIR) / redis / memory
# LANGGRAPH_CHECKPOINTER=sqlite
# INTERNSHIP_SCHEDULER_INTERVAL_S=900   # auto-close punch-outs, stall scan, Friday quizzes, day 30/60/90 appraisals
# dev = pixel comparison, NOT face recognition (dev/test only); insightface for real use
IDENTITY_ENGINE=dev
IDENTITY_MATCH_THRESHOLD=0.45
IDENTITY_UNCERTAIN_THRESHOLD=0.30
# proctoring defaults
GLANCE_MIN_S=1.0
FLAG_THRESHOLD_S=3.0
MAX_FLAGS=3
YAW_LIMIT_DEG=30
PITCH_LIMIT_DEG=20
RETURN_TO_SCREEN_S=0.5
# evaluation rules
STRONG_TOPIC_PCT=80
WEAK_TOPIC_PCT=60
MIN_QUESTIONS_PER_TOPIC=3
MISCONCEPTION_MIN_COUNT=2
# background (run the evaluation agent after scoring) / off
EVALUATION_JOBS=background
